# Copie este arquivo para .streamlit/secrets.toml e ajuste só o que precisar.
# Sem secrets.toml o app já usa os padrões abaixo.
# No Windows, use aspas simples nos caminhos (por causa das barras invertidas).

[central]
# Pastas varridas (com subpastas). "~" = C:\Users\<seu usuário>
pastas = [
  '~\OneDrive - Alpargatas S.A\PCM F26 - Documentos\1.3 - Controle de Estoque',
  '~\OneDrive - Alpargatas S.A\PCM F26 - Documentos\0.1 - Indicadores',
]
# Onde o app grava uploads, cadastros (equipamentos, estoque mínimo) e usuários.
# Padrão: subpasta "Central de Manutenção (app)" dentro da primeira pasta acima.
# pasta_app = '~\OneDrive - Alpargatas S.A\PCM F26 - Documentos\1.3 - Controle de Estoque\Central de Manutenção (app)'

profundidade = 4               # níveis de subpasta varridos
intervalo_verificacao = 60     # segundos entre verificações de arquivo novo
dias_alerta = 2                # base mais velha que isso aparece como desatualizada
excluir_piloto_matriz = "sim"  # tira Fábrica Piloto / Matrizaria das ordens
exigir_login = "sim"           # "nao" desliga a tela de login (uso só local)

# --- Alternativa: ler direto do SharePoint (para hospedar o app na nuvem) ---
# Precisa de um aplicativo registrado no Azure AD com permissão Sites.Selected
# (ou Sites.ReadWrite.All) concedida pela TI.
# fonte = "sharepoint"
# sp_tenant_id = "..."
# sp_client_id = "..."
# sp_client_secret = "..."
# sp_site = "alpargatascombr.sharepoint.com:/sites/PCMF26"
# sp_pasta = "1.3 - Controle de Estoque"
