# Copie para .env.local (na Vercel: Project › Settings › Environment Variables).
# Nenhum valor real vai para o repositório.

# Repositório PRIVADO de dados (o mesmo do sincronizador / site atual) e um token com acesso só a ele
DADOS_GH_REPO=6178609/estoquemanutencao-dados
DADOS_GH_TOKEN=
DADOS_GH_RAMO=main

# Alternativa local (desenvolvimento): pasta com bases/*.parquet e app/*.json
# DADOS_PASTA=/caminho/para/a/pasta

# Segredo das sessões (32+ caracteres aleatórios). Sem ele não há login.
SESSAO_SEGREDO=

# Endereço do site atual (Streamlit), para as abas que ainda não foram migradas
URL_SITE_ATUAL=https://central-manutencao-f26.streamlit.app
