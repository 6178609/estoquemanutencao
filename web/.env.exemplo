# Copie para .env.local (na Vercel: Project › Settings › Environment Variables).
# Nenhum valor real vai para o repositório.

# Repositório PRIVADO de dados (o mesmo do sincronizador do PC) e um token com acesso só a ele
DADOS_GH_REPO=6178609/estoquemanutencao-dados
DADOS_GH_TOKEN=
DADOS_GH_RAMO=main

# Alternativa local (desenvolvimento): pasta com bases/*.parquet e app/*.json
# DADOS_PASTA=/caminho/para/a/pasta

# Código pedido para criar o PRIMEIRO administrador (obrigatório, mínimo de 16 caracteres, aleatório;
# sem ele o cadastro inicial fica desligado). Gere com: openssl rand -base64 24
# CODIGO_CONFIG=

# Limite de tentativas de login compartilhado entre todas as instâncias da Vercel (recomendado):
# Vercel › Storage › Upstash Redis. Sem isso o limite vale só dentro de cada instância.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# DADOS_GH_TOKEN: use um token "fine-grained" só para o repositório de dados, com a permissão
# Repository › Contents: Read and write (nenhuma outra) e validade de no máximo 90 dias.
