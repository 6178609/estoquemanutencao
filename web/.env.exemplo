# Copie para .env.local (na Vercel: Project › Settings › Environment Variables).
# Nenhum valor real vai para o repositório.

# Repositório PRIVADO de dados e um token com acesso só a ele
DADOS_GH_REPO=6178609/estoquemanutencao-dados
DADOS_GH_TOKEN=
DADOS_GH_RAMO=main

# Cadastros no Supabase (opcional; sem as duas, ficam em app/*.json no repositório de dados)
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SECRET_KEY=

# Alternativa local (desenvolvimento): pasta com bases/*.parquet e app/*.json
# DADOS_PASTA=/caminho/para/a/pasta

# Só na pasta local: código pedido para criar o primeiro administrador (no modo GitHub o código são os
# 6 últimos caracteres de DADOS_GH_TOKEN)
# CODIGO_CONFIG=
